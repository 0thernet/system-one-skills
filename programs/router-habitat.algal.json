{
  "contract": "algal.organism.v1",
  "key": "organism:router-habitat",
  "name": "Router habitat",
  "note": "Malleable habitat: an agent proposes ONE candidate router manifest as data, the each-cell population evaluates it against labeled cases through hab-eval-inner, and a pure scorer emits the fitness record. The host promotes winners into the router:champion slot — evolution never mutates the running organism.",
  "budgets": { "maxSteps": 96, "maxAgentCalls": 40, "maxWork": 800000, "maxDepth": 6 },
  "interface": {
    "inputs": {
      "cases": { "cell": "src", "port": "cases" },
      "champion": { "cell": "src", "port": "champion" },
      "feedback": { "cell": "src", "port": "feedback" }
    },
    "outputs": {
      "candidate": { "cell": "gen", "port": "out" },
      "score": { "cell": "score", "port": "out" }
    }
  },
  "cells": [
    {
      "id": "src",
      "kind": "input",
      "outputs": { "cases": "json", "champion": "json", "feedback": "text" }
    },
    { "id": "d-champ", "kind": "const", "outputs": { "v": { "type": "json", "value": {} } } },
    { "id": "d-fb", "kind": "const", "outputs": { "v": { "type": "text", "value": "" } } },
    { "id": "champ", "kind": "fn", "fn": "coalesce.v1" },
    { "id": "fb", "kind": "fn", "fn": "coalesce.v1" },
    {
      "id": "gen",
      "kind": "agent",
      "inputs": { "cases": "json", "champion": "json", "feedback": "json" },
      "prompt": "Emit ONE candidate router manifest as JSON (contract algal.organism.v1). Shape: input cell src {task: text}; classifier cell route with output {kind: choice, labels: [survey, digest, diff, test, ci, search, fetch, gate, direct], onMiss: direct}; expr cell fmt formatting 'route → <lane>'; edges src.task→route.task and route.out→fmt.l. You may improve ONLY the classifier prompt text and budgets — do not change cell ids, kinds, labels, or edges. If a champion manifest is provided, mutate its prompt; otherwise write a fresh one. If feedback is provided, address it.",
      "view": { "inputs": "*" },
      "output": { "kind": "json", "schema": { "type": "object", "required": ["contract", "cells", "edges"] } },
      "budget": { "maxContextBytes": 40000, "maxOutputBytes": 32768, "maxEffectMs": 120000 }
    },
    {
      "id": "eval",
      "kind": "each",
      "manifest": "sha256:2df3efda5116ef88dfaf6b1946b99257283c17016029a71c0dcd7bf7a549bab2",
      "over": "item",
      "maxItems": 32
    },
    {
      "id": "score",
      "kind": "expr",
      "inputs": { "evals": "json", "cases": "json" },
      "expr": {
        "contract": "algal.expr.v1",
        "program": {
          "passed": ["len", ["filter", ["get", "evals"], "e", ["get", "e", "ok"]]],
          "total": ["len", ["get", "cases"]],
          "score": ["div",
            ["len", ["filter", ["get", "evals"], "e", ["get", "e", "ok"]]],
            ["len", ["get", "cases"]]]
        }
      },
      "output": {
        "kind": "json",
        "schema": {
          "type": "object",
          "required": ["passed", "total", "score"],
          "properties": { "passed": { "type": "number" }, "total": { "type": "number" }, "score": { "type": "number" } }
        }
      }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "cases" }, "to": { "cell": "gen", "port": "cases" } },
    { "from": { "cell": "src", "port": "champion" }, "to": { "cell": "champ", "port": "a" } },
    { "from": { "cell": "d-champ", "port": "v" }, "to": { "cell": "champ", "port": "b" } },
    { "from": { "cell": "champ", "port": "value" }, "to": { "cell": "gen", "port": "champion" } },
    { "from": { "cell": "src", "port": "feedback" }, "to": { "cell": "fb", "port": "a" } },
    { "from": { "cell": "d-fb", "port": "v" }, "to": { "cell": "fb", "port": "b" } },
    { "from": { "cell": "fb", "port": "value" }, "to": { "cell": "gen", "port": "feedback" } },
    { "from": { "cell": "src", "port": "cases" }, "to": { "cell": "eval", "port": "item" } },
    { "from": { "cell": "gen", "port": "out" }, "to": { "cell": "eval", "port": "candidate" } },
    { "from": { "cell": "eval", "port": "verdict" }, "to": { "cell": "score", "port": "evals" } },
    { "from": { "cell": "src", "port": "cases" }, "to": { "cell": "score", "port": "cases" } }
  ]
}
