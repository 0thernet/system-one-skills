{
  "contract": "algal.organism.v1",
  "key": "organism:ci-watch",
  "name": "CI watch",
  "note": "Polls the latest CI run inside a bounded repeat cell and returns only the terminal status. The sleep+gh-poll loop — and every intermediate status dump — stays inside the runtime, out of the model's context.",
  "budgets": { "maxSteps": 64, "maxAgentCalls": 0, "maxWork": 100000 },
  "interface": {
    "inputs": {
      "cwd": { "cell": "src", "port": "cwd" },
      "wait-ms": { "cell": "src", "port": "wait-ms" }
    },
    "outputs": {
      "report": { "cell": "loop", "port": "report" },
      "summary": { "cell": "fmt", "port": "out" }
    }
  },
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "cwd": "text", "wait-ms": "json" } },
    { "id": "default-wait", "kind": "const", "outputs": { "v": { "type": "json", "value": 20000 } } },
    { "id": "wait", "kind": "fn", "fn": "coalesce.v1" },
    {
      "id": "loop",
      "kind": "repeat",
      "manifest": "sha256:430d4c9a4033d360e12ae4cc0f20ff986c46eb6a1e2bfc8acd5e6554461e646a",
      "maxRounds": 16,
      "until": { "output": "report", "field": "status", "equals": "completed" }
    },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": { "r": "json" },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "if", ["eq", ["get", "r", "ok"], true],
          ["sconcat",
            "ci ", ["if", ["isText", ["get", "r", "status"]], ["get", "r", "status"], "unknown"],
            ["if", ["isText", ["get", "r", "conclusion"]],
              ["sconcat", " / ", ["get", "r", "conclusion"]], ""],
            ["if", ["isText", ["get", "r", "url"]],
              ["sconcat", "\n", ["get", "r", "url"]], ""]],
          ["sconcat", "ci watch failed: ",
            ["if", ["isText", ["get", "r", "error"]], ["get", "r", "error"], "unknown error"]]]
      },
      "output": { "kind": "text" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "cwd" }, "to": { "cell": "loop", "port": "cwd" } },
    { "from": { "cell": "src", "port": "wait-ms" }, "to": { "cell": "wait", "port": "a" } },
    { "from": { "cell": "default-wait", "port": "v" }, "to": { "cell": "wait", "port": "b" } },
    { "from": { "cell": "wait", "port": "value" }, "to": { "cell": "loop", "port": "wait-ms" } },
    { "from": { "cell": "loop", "port": "report" }, "to": { "cell": "fmt", "port": "r" } }
  ]
}
