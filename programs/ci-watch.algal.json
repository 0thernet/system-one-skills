{
  "contract": "algal.organism.v1",
  "key": "organism:ci-watch",
  "name": "CI watch",
  "note": "Selects a CI run for the current HEAD (or explicit run-id), then polls that immutable run ID until completion, error, or the bounded round limit. A receipt proves only this run, not every required check.",
  "budgets": {
    "maxSteps": 64,
    "maxAgentCalls": 0,
    "maxWork": 100000
  },
  "interface": {
    "inputs": {
      "cwd": {
        "cell": "src",
        "port": "cwd"
      },
      "wait-ms": {
        "cell": "src",
        "port": "wait-ms"
      },
      "run-id": {
        "cell": "src",
        "port": "run-id"
      }
    },
    "outputs": {
      "report": {
        "cell": "loop",
        "port": "report"
      },
      "summary": {
        "cell": "fmt",
        "port": "out"
      }
    }
  },
  "cells": [
    {
      "id": "src",
      "kind": "input",
      "outputs": {
        "cwd": "text",
        "wait-ms": "json",
        "run-id": "text"
      }
    },
    {
      "id": "default-wait",
      "kind": "const",
      "outputs": {
        "v": {
          "type": "json",
          "value": 20000
        }
      }
    },
    {
      "id": "wait",
      "kind": "fn",
      "fn": "coalesce.v1"
    },
    {
      "id": "loop",
      "kind": "repeat",
      "manifest": "sha256:44a90529b21c5e3bcbe44e4a737e74e76d9c2bf775817f8aa7ebf517b4bb910d",
      "maxRounds": 16,
      "until": {
        "output": "report",
        "field": "done",
        "equals": "stop"
      }
    },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": {
        "r": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "if",
          [
            "eq",
            [
              "get",
              "r",
              "ok"
            ],
            true
          ],
          [
            "sconcat",
            "ci ",
            [
              "if",
              [
                "isText",
                [
                  "get",
                  "r",
                  "status"
                ]
              ],
              [
                "get",
                "r",
                "status"
              ],
              "unknown"
            ],
            [
              "if",
              [
                "isText",
                [
                  "get",
                  "r",
                  "conclusion"
                ]
              ],
              [
                "sconcat",
                " / ",
                [
                  "get",
                  "r",
                  "conclusion"
                ]
              ],
              ""
            ],
            [
              "if",
              [
                "isText",
                [
                  "get",
                  "r",
                  "url"
                ]
              ],
              [
                "sconcat",
                "\n",
                [
                  "get",
                  "r",
                  "url"
                ]
              ],
              ""
            ]
          ],
          [
            "sconcat",
            "ci watch failed: ",
            [
              "if",
              [
                "isText",
                [
                  "get",
                  "r",
                  "error"
                ]
              ],
              [
                "get",
                "r",
                "error"
              ],
              "unknown error"
            ]
          ]
        ]
      },
      "output": {
        "kind": "text"
      }
    },
    {
      "id": "initial",
      "kind": "tool",
      "tool": "ci.status.v1",
      "budget": {
        "maxEffectMs": 35000
      }
    },
    {
      "id": "selected",
      "kind": "expr",
      "inputs": {
        "r": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "get",
          "r",
          "run_id"
        ]
      },
      "output": {
        "kind": "text"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "cell": "src",
        "port": "cwd"
      },
      "to": {
        "cell": "loop",
        "port": "cwd"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "wait-ms"
      },
      "to": {
        "cell": "wait",
        "port": "a"
      }
    },
    {
      "from": {
        "cell": "default-wait",
        "port": "v"
      },
      "to": {
        "cell": "wait",
        "port": "b"
      }
    },
    {
      "from": {
        "cell": "wait",
        "port": "value"
      },
      "to": {
        "cell": "loop",
        "port": "wait-ms"
      }
    },
    {
      "from": {
        "cell": "loop",
        "port": "report"
      },
      "to": {
        "cell": "fmt",
        "port": "r"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "cwd"
      },
      "to": {
        "cell": "initial",
        "port": "cwd"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "run-id"
      },
      "to": {
        "cell": "initial",
        "port": "run-id"
      }
    },
    {
      "from": {
        "cell": "initial",
        "port": "report"
      },
      "to": {
        "cell": "selected",
        "port": "r"
      }
    },
    {
      "from": {
        "cell": "selected",
        "port": "out"
      },
      "to": {
        "cell": "loop",
        "port": "run-id"
      }
    }
  ]
}
