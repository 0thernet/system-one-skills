{
  "contract": "algal.organism.v1",
  "key": "organism:research-triage",
  "name": "Research triage",
  "note": "Builds a bounded multi-source evidence bundle, then uses one typed decision effect to classify relevance, evidence quality, and sufficiency. Jev is admitted automatically only when configured.",
  "budgets": {
    "maxSteps": 16,
    "maxAgentCalls": 1,
    "maxWork": 240000
  },
  "interface": {
    "inputs": {
      "sources": {
        "cell": "src",
        "port": "sources"
      },
      "question": {
        "cell": "src",
        "port": "question"
      },
      "max-sources": {
        "cell": "src",
        "port": "max-sources"
      },
      "max-bytes-per-source": {
        "cell": "src",
        "port": "max-bytes-per-source"
      }
    },
    "outputs": {
      "bundle": {
        "cell": "gather",
        "port": "report"
      },
      "triage": {
        "cell": "judge",
        "port": "out"
      },
      "summary": {
        "cell": "fmt",
        "port": "out"
      }
    }
  },
  "cells": [
    {
      "id": "src",
      "kind": "input",
      "outputs": {
        "sources": "json",
        "question": "text",
        "max-sources": "json",
        "max-bytes-per-source": "json"
      }
    },
    {
      "id": "default-question",
      "kind": "const",
      "outputs": {
        "v": {
          "type": "text",
          "value": "Assess whether this evidence is useful and sufficient."
        }
      }
    },
    {
      "id": "question",
      "kind": "fn",
      "fn": "coalesce.v1"
    },
    {
      "id": "gather",
      "kind": "tool",
      "tool": "research.bundle.v1"
    },
    {
      "id": "judge",
      "kind": "decide",
      "inputs": {
        "evidence": "json",
        "question": "json"
      },
      "prompt": "Triage the bounded research evidence against the declared question. Do not invent facts outside the supplied sources.",
      "questions": {
        "relevance": {
          "type": "choice",
          "instructions": "Classify the evidence relationship to the research question.",
          "criteria": {
            "supports": "Evidence supports a likely answer",
            "contradicts": "Evidence challenges the likely answer",
            "mixed": "Evidence materially conflicts or is mixed",
            "irrelevant": "Evidence does not answer the question"
          }
        },
        "sufficient": {
          "type": "noul",
          "instructions": "Probability that the current evidence is sufficient to answer responsibly."
        },
        "source_quality": {
          "type": "score",
          "instructions": "Rate overall source quality from 1 (weak) to 5 (strong).",
          "criteria": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ]
        }
      },
      "view": {
        "inputs": "*"
      },
      "budget": {
        "maxContextBytes": 98304,
        "maxOutputBytes": 4096,
        "maxEffectMs": 60000
      }
    },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": {
        "a": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "sconcat",
          [
            "get",
            "a",
            "answers",
            "relevance",
            "choice"
          ],
          " | sufficient ",
          [
            "toText",
            [
              "get",
              "a",
              "answers",
              "sufficient",
              "noul"
            ]
          ],
          " | source quality ",
          [
            "toText",
            [
              "get",
              "a",
              "answers",
              "source_quality",
              "score"
            ]
          ]
        ]
      },
      "output": {
        "kind": "text"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "cell": "src",
        "port": "sources"
      },
      "to": {
        "cell": "gather",
        "port": "sources"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "max-sources"
      },
      "to": {
        "cell": "gather",
        "port": "max-sources"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "max-bytes-per-source"
      },
      "to": {
        "cell": "gather",
        "port": "max-bytes-per-source"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "question"
      },
      "to": {
        "cell": "question",
        "port": "a"
      }
    },
    {
      "from": {
        "cell": "default-question",
        "port": "v"
      },
      "to": {
        "cell": "question",
        "port": "b"
      }
    },
    {
      "from": {
        "cell": "gather",
        "port": "report"
      },
      "to": {
        "cell": "judge",
        "port": "evidence"
      },
      "guard": {
        "expr": {
          "contract": "algal.expr.v1",
          "program": [
            "eq",
            [
              "get",
              "value",
              "ok"
            ],
            true
          ]
        }
      }
    },
    {
      "from": {
        "cell": "question",
        "port": "value"
      },
      "to": {
        "cell": "judge",
        "port": "question"
      }
    },
    {
      "from": {
        "cell": "judge",
        "port": "out"
      },
      "to": {
        "cell": "fmt",
        "port": "a"
      }
    }
  ]
}
