{
  "contract": "algal.organism.v1",
  "key": "organism:web-fetch",
  "name": "Web fetch",
  "note": "Bounded page fetch: HTML stripped to text, clipped to a byte cap, with source byte count — the model sees the extract, not the raw page.",
  "budgets": { "maxSteps": 8, "maxAgentCalls": 0, "maxWork": 60000 },
  "interface": {
    "inputs": {
      "url": { "cell": "src", "port": "url" },
      "max-bytes": { "cell": "src", "port": "max-bytes" }
    },
    "outputs": {
      "result": { "cell": "probe", "port": "report" },
      "text": { "cell": "fmt", "port": "out" }
    }
  },
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "url": "text", "max-bytes": "json" } },
    { "id": "probe", "kind": "tool", "tool": "web.fetch.v1", "budget": { "maxEffectMs": 45000 } },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": { "r": "json" },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "if", ["eq", ["get", "r", "ok"], true],
          ["sconcat",
            "[", ["toText", ["get", "r", "status"]], " ",
            ["if", ["isText", ["get", "r", "content_type"]], ["get", "r", "content_type"], "?"],
            " ", ["toText", ["get", "r", "source_bytes"]], "B source",
            ["if", ["eq", ["get", "r", "truncated"], true], ", clipped]", "]"],
            "\n", ["get", "r", "text"]],
          ["sconcat", "fetch failed: ",
            ["if", ["isText", ["get", "r", "error"]], ["get", "r", "error"], "unknown error"]]]
      },
      "output": { "kind": "text" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "url" }, "to": { "cell": "probe", "port": "url" } },
    { "from": { "cell": "src", "port": "max-bytes" }, "to": { "cell": "probe", "port": "max-bytes" } },
    { "from": { "cell": "probe", "port": "report" }, "to": { "cell": "fmt", "port": "r" } }
  ]
}
