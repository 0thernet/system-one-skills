{
  "contract": "algal.organism.v1",
  "key": "organism:repo-survey",
  "name": "Repo survey",
  "note": "One bounded tool call produces the repo map — top-level dirs, manifests, key source files, README head — replacing the ls/find/cat round-trips an agent would otherwise spend context on.",
  "budgets": { "maxSteps": 8, "maxAgentCalls": 0, "maxWork": 100000 },
  "interface": {
    "inputs": {
      "cwd": { "cell": "src", "port": "cwd" },
      "max-entries": { "cell": "src", "port": "max-entries" }
    },
    "outputs": {
      "survey": { "cell": "probe", "port": "report" },
      "summary": { "cell": "fmt", "port": "out" }
    }
  },
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "cwd": "text", "max-entries": "json" } },
    { "id": "probe", "kind": "tool", "tool": "repo.survey.v1", "budget": { "maxEffectMs": 60000 } },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": { "r": "json" },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "if", ["eq", ["get", "r", "ok"], true],
          ["sconcat",
            "files ", ["toText", ["get", "r", "file_count"]],
            ["if", ["eq", ["get", "r", "truncated"], true], " (truncated)", ""],
            "\ndirs:\n", ["join", ["get", "r", "dirs"], "\n"],
            "\nmanifests:\n", ["join", ["get", "r", "manifests"], "\n"],
            "\nreadme:\n", ["get", "r", "readme_head"]],
          ["sconcat", "repo survey failed: ",
            ["if", ["isText", ["get", "r", "error"]], ["get", "r", "error"], "unknown error"]]]
      },
      "output": { "kind": "text" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "cwd" }, "to": { "cell": "probe", "port": "cwd" } },
    { "from": { "cell": "src", "port": "max-entries" }, "to": { "cell": "probe", "port": "max-entries" } },
    { "from": { "cell": "probe", "port": "report" }, "to": { "cell": "fmt", "port": "r" } }
  ]
}
