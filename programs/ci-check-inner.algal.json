{
  "contract": "algal.organism.v1",
  "key": "organism:ci-check-inner",
  "name": "CI status check (one round)",
  "note": "A single bounded CI status probe; ci-watch repeats it until the run reaches a terminal state.",
  "budgets": { "maxSteps": 4, "maxAgentCalls": 0, "maxWork": 20000 },
  "interface": {
    "inputs": {
      "cwd": { "cell": "src", "port": "cwd" },
      "wait-ms": { "cell": "src", "port": "wait-ms" }
    },
    "outputs": { "report": { "cell": "probe", "port": "report" } }
  },
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "cwd": "text", "wait-ms": "json" } },
    { "id": "probe", "kind": "tool", "tool": "ci.status.v1", "budget": { "maxEffectMs": 90000 } }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "cwd" }, "to": { "cell": "probe", "port": "cwd" } },
    { "from": { "cell": "src", "port": "wait-ms" }, "to": { "cell": "probe", "port": "wait-ms" } }
  ]
}
