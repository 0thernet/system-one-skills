{
  "contract": "algal.organism.v1",
  "key": "organism:search-slice",
  "name": "Search slice",
  "note": "Bounded ripgrep inside a tool call: the agent gets the top-N match lines, never a raw grep dump to page through.",
  "budgets": { "maxSteps": 8, "maxAgentCalls": 0, "maxWork": 80000 },
  "interface": {
    "inputs": {
      "pattern": { "cell": "src", "port": "pattern" },
      "cwd": { "cell": "src", "port": "cwd" },
      "glob": { "cell": "src", "port": "glob" },
      "max-matches": { "cell": "src", "port": "max-matches" }
    },
    "outputs": {
      "result": { "cell": "probe", "port": "report" },
      "text": { "cell": "fmt", "port": "out" }
    }
  },
  "cells": [
    {
      "id": "src",
      "kind": "input",
      "outputs": { "pattern": "text", "cwd": "text", "glob": "text", "max-matches": "json" }
    },
    { "id": "probe", "kind": "tool", "tool": "search.slice.v1", "budget": { "maxEffectMs": 45000 } },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": { "r": "json" },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "if", ["eq", ["get", "r", "ok"], true],
          ["sconcat",
            ["toText", ["get", "r", "total"]], " matches",
            ["if", ["eq", ["get", "r", "truncated"], true], " (truncated)", ""], "\n",
            ["join",
              ["map", ["get", "r", "matches"], "m",
                ["sconcat",
                  ["get", "m", "file"], ":",
                  ["toText", ["get", "m", "line"]], ": ",
                  ["get", "m", "text"]]],
              "\n"]],
          ["sconcat", "search failed: ",
            ["if", ["isText", ["get", "r", "error"]], ["get", "r", "error"], "unknown error"]]]
      },
      "output": { "kind": "text" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "pattern" }, "to": { "cell": "probe", "port": "pattern" } },
    { "from": { "cell": "src", "port": "cwd" }, "to": { "cell": "probe", "port": "cwd" } },
    { "from": { "cell": "src", "port": "glob" }, "to": { "cell": "probe", "port": "glob" } },
    { "from": { "cell": "src", "port": "max-matches" }, "to": { "cell": "probe", "port": "max-matches" } },
    { "from": { "cell": "probe", "port": "report" }, "to": { "cell": "fmt", "port": "r" } }
  ]
}
