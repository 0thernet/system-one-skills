{
  "contract": "algal.organism.v1",
  "key": "organism:writing-evaluate",
  "name": "Writing evaluate",
  "note": "Runs a deterministic writing audit and one typed decision effect for dominant issue, publish-readiness probability, and quality score. It evaluates but does not generate or rewrite prose.",
  "budgets": {
    "maxSteps": 16,
    "maxAgentCalls": 1,
    "maxWork": 220000
  },
  "interface": {
    "inputs": {
      "text": {
        "cell": "src",
        "port": "text"
      },
      "audience": {
        "cell": "src",
        "port": "audience"
      },
      "max-bytes": {
        "cell": "src",
        "port": "max-bytes"
      }
    },
    "outputs": {
      "audit": {
        "cell": "audit",
        "port": "report"
      },
      "evaluation": {
        "cell": "judge",
        "port": "out"
      },
      "summary": {
        "cell": "fmt",
        "port": "out"
      }
    }
  },
  "cells": [
    {
      "id": "src",
      "kind": "input",
      "outputs": {
        "text": "text",
        "audience": "text",
        "max-bytes": "json"
      }
    },
    {
      "id": "default-audience",
      "kind": "const",
      "outputs": {
        "v": {
          "type": "text",
          "value": "general reader"
        }
      }
    },
    {
      "id": "audience",
      "kind": "fn",
      "fn": "coalesce.v1"
    },
    {
      "id": "audit",
      "kind": "tool",
      "tool": "writing.audit.v1"
    },
    {
      "id": "judge",
      "kind": "decide",
      "inputs": {
        "audit": "json",
        "audience": "json"
      },
      "prompt": "Evaluate the bounded draft text in the audit for the declared audience. The audit may cover a prefix only; do not infer quality or publication readiness of omitted text. Do not rewrite the draft.",
      "questions": {
        "dominant_issue": {
          "type": "choice",
          "instructions": "Choose the single most important remaining issue.",
          "criteria": {
            "clarity": "Meaning is hard to follow",
            "structure": "Organization or flow is weak",
            "evidence": "Claims need stronger support",
            "tone": "Voice mismatches the audience",
            "mechanics": "Grammar or formatting dominates",
            "none": "No material issue"
          }
        },
        "publish_ready": {
          "type": "noul",
          "instructions": "Probability that this draft is ready to publish for the audience."
        },
        "quality": {
          "type": "score",
          "instructions": "Rate overall writing quality from 1 (poor) to 5 (excellent).",
          "criteria": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ]
        }
      },
      "view": {
        "inputs": "*"
      },
      "budget": {
        "maxContextBytes": 98304,
        "maxOutputBytes": 4096,
        "maxEffectMs": 60000
      }
    },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": {
        "a": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "sconcat",
          "issue ",
          [
            "get",
            "a",
            "answers",
            "dominant_issue",
            "choice"
          ],
          " | publish ready ",
          [
            "toText",
            [
              "get",
              "a",
              "answers",
              "publish_ready",
              "noul"
            ]
          ],
          " | quality ",
          [
            "toText",
            [
              "get",
              "a",
              "answers",
              "quality",
              "score"
            ]
          ]
        ]
      },
      "output": {
        "kind": "text"
      }
    },
    {
      "id": "with-text",
      "kind": "const",
      "outputs": {
        "v": {
          "type": "json",
          "value": true
        }
      }
    }
  ],
  "edges": [
    {
      "from": {
        "cell": "src",
        "port": "text"
      },
      "to": {
        "cell": "audit",
        "port": "text"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "max-bytes"
      },
      "to": {
        "cell": "audit",
        "port": "max-bytes"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "audience"
      },
      "to": {
        "cell": "audience",
        "port": "a"
      }
    },
    {
      "from": {
        "cell": "default-audience",
        "port": "v"
      },
      "to": {
        "cell": "audience",
        "port": "b"
      }
    },
    {
      "from": {
        "cell": "audit",
        "port": "report"
      },
      "to": {
        "cell": "judge",
        "port": "audit"
      },
      "guard": {
        "expr": {
          "contract": "algal.expr.v1",
          "program": [
            "eq",
            [
              "get",
              "value",
              "ok"
            ],
            true
          ]
        }
      }
    },
    {
      "from": {
        "cell": "audience",
        "port": "value"
      },
      "to": {
        "cell": "judge",
        "port": "audience"
      }
    },
    {
      "from": {
        "cell": "judge",
        "port": "out"
      },
      "to": {
        "cell": "fmt",
        "port": "a"
      }
    },
    {
      "from": {
        "cell": "with-text",
        "port": "v"
      },
      "to": {
        "cell": "audit",
        "port": "include-text"
      }
    }
  ]
}
