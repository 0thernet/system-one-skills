{
  "contract": "algal.organism.v1",
  "key": "organism:research-bundle",
  "name": "Research bundle",
  "note": "Collects up to twelve URL or inline-text sources into one bounded evidence bundle. Fetching, HTML stripping, clipping, and per-source failure isolation stay outside model context.",
  "budgets": { "maxSteps": 8, "maxAgentCalls": 0, "maxWork": 160000 },
  "interface": {
    "inputs": {
      "sources": { "cell": "src", "port": "sources" },
      "max-sources": { "cell": "src", "port": "max-sources" },
      "max-bytes-per-source": { "cell": "src", "port": "max-bytes-per-source" }
    },
    "outputs": {
      "bundle": { "cell": "gather", "port": "report" },
      "summary": { "cell": "fmt", "port": "out" }
    }
  },
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "sources": "json", "max-sources": "json", "max-bytes-per-source": "json" } },
    { "id": "gather", "kind": "tool", "tool": "research.bundle.v1" },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": { "r": "json" },
      "expr": {
        "contract": "algal.expr.v1",
        "program": ["sconcat", ["toText", ["get", "r", "success_count"]], "/", ["toText", ["get", "r", "source_count"]], " sources | ", ["toText", ["get", "r", "text_bytes"]], " text bytes | errors ", ["toText", ["get", "r", "error_count"]]]
      },
      "output": { "kind": "text" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "sources" }, "to": { "cell": "gather", "port": "sources" } },
    { "from": { "cell": "src", "port": "max-sources" }, "to": { "cell": "gather", "port": "max-sources" } },
    { "from": { "cell": "src", "port": "max-bytes-per-source" }, "to": { "cell": "gather", "port": "max-bytes-per-source" } },
    { "from": { "cell": "gather", "port": "report" }, "to": { "cell": "fmt", "port": "r" } }
  ]
}
