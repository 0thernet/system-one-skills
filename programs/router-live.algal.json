{
  "contract": "algal.organism.v1",
  "key": "organism:router-live",
  "name": "Router (live champion)",
  "note": "Routes through the champion manifest in the router-champion slot \u2014 the durable endpoint of router-habitat promotion. An empty slot serves the packaged default router via the slot's declared default.",
  "budgets": {
    "maxSteps": 16,
    "maxAgentCalls": 2,
    "maxWork": 60000,
    "maxDepth": 4
  },
  "interface": {
    "inputs": {
      "task": {
        "cell": "src",
        "port": "task"
      }
    },
    "outputs": {
      "lane": {
        "cell": "lane",
        "port": "out"
      },
      "summary": {
        "cell": "fmt",
        "port": "out"
      }
    }
  },
  "cells": [
    {
      "id": "src",
      "kind": "input",
      "outputs": {
        "task": "text"
      }
    },
    {
      "id": "champion",
      "kind": "slot",
      "name": "router-champion",
      "mode": "read",
      "default": {
        "contract": "algal.organism.v1",
        "key": "organism:router",
        "name": "Skill router",
        "note": "One classifier call maps a task description to the system-one-skills lane that should handle it. This manifest is the malleable genotype: router-habitat evolves its prompt against labeled cases.",
        "budgets": {
          "maxSteps": 8,
          "maxAgentCalls": 1,
          "maxWork": 40000
        },
        "interface": {
          "inputs": {
            "task": {
              "cell": "src",
              "port": "task"
            }
          },
          "outputs": {
            "lane": {
              "cell": "route",
              "port": "out"
            },
            "summary": {
              "cell": "fmt",
              "port": "out"
            }
          }
        },
        "cells": [
          {
            "id": "src",
            "kind": "input",
            "outputs": {
              "task": "text"
            }
          },
          {
            "id": "route",
            "kind": "classifier",
            "inputs": {
              "task": "text"
            },
            "prompt": "Route the task to exactly one lane:\n- survey: map an unfamiliar repo (files, layout, entry points)\n- digest: current git state (branch, staged/unstaged, recent commits)\n- diff: inspect or review the working diff / a revision\n- test: run the project's test or check command and read the verdict\n- ci: check or wait on CI status\n- search: find where something is defined or used in the codebase\n- fetch: read a web page or URL\n- gate: run release gates (test+lint+typecheck+build) before shipping\n- direct: none of the above \u2014 handle it yourself",
            "view": {
              "inputs": [
                "task"
              ]
            },
            "output": {
              "kind": "choice",
              "labels": [
                "survey",
                "digest",
                "diff",
                "test",
                "ci",
                "search",
                "fetch",
                "gate",
                "direct"
              ],
              "onMiss": "direct"
            },
            "budget": {
              "maxContextBytes": 8192,
              "maxOutputBytes": 1024,
              "maxEffectMs": 60000
            }
          },
          {
            "id": "fmt",
            "kind": "expr",
            "inputs": {
              "l": "text"
            },
            "expr": {
              "contract": "algal.expr.v1",
              "program": [
                "sconcat",
                "route \u2192 ",
                [
                  "get",
                  "l"
                ]
              ]
            },
            "output": {
              "kind": "text"
            }
          }
        ],
        "edges": [
          {
            "from": {
              "cell": "src",
              "port": "task"
            },
            "to": {
              "cell": "route",
              "port": "task"
            }
          },
          {
            "from": {
              "cell": "route",
              "port": "out"
            },
            "to": {
              "cell": "fmt",
              "port": "l"
            }
          }
        ]
      }
    },
    {
      "id": "mkargs",
      "kind": "expr",
      "inputs": {
        "task": "text"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": {
          "task": [
            "get",
            "task"
          ]
        }
      },
      "output": {
        "kind": "json",
        "schema": {
          "type": "object",
          "required": [
            "task"
          ],
          "properties": {
            "task": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "run",
      "kind": "spawn"
    },
    {
      "id": "lane",
      "kind": "expr",
      "inputs": {
        "data": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "get",
          "data",
          "lane"
        ]
      },
      "output": {
        "kind": "text"
      }
    },
    {
      "id": "fmt",
      "kind": "expr",
      "inputs": {
        "l": "text"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "sconcat",
          "route \u2192 ",
          [
            "get",
            "l"
          ]
        ]
      },
      "output": {
        "kind": "text"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "cell": "champion",
        "port": "data"
      },
      "to": {
        "cell": "run",
        "port": "manifest"
      }
    },
    {
      "from": {
        "cell": "src",
        "port": "task"
      },
      "to": {
        "cell": "mkargs",
        "port": "task"
      }
    },
    {
      "from": {
        "cell": "mkargs",
        "port": "out"
      },
      "to": {
        "cell": "run",
        "port": "args"
      }
    },
    {
      "from": {
        "cell": "run",
        "port": "data"
      },
      "to": {
        "cell": "lane",
        "port": "data"
      }
    },
    {
      "from": {
        "cell": "lane",
        "port": "out"
      },
      "to": {
        "cell": "fmt",
        "port": "l"
      }
    }
  ]
}